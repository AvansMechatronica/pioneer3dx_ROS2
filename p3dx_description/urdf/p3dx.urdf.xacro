<?xml version="1.0"?>
<robot name="p3dx_2wd" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="sim" default="false" />
  <!--<xacro:include filename="$(find p3dx_description)/urdf/2wd_properties.urdf.xacro" />-->
  <xacro:include filename="$(find p3dx_description)/urdf/mech/base.urdf.xacro" />
  <!--<xacro:include filename="$(find p3dx_description)/urdf/mech/wheel.urdf.xacro" />
  <xacro:include filename="$(find p3dx_description)/urdf/mech/caster_wheel.urdf.xacro" />-->
  <xacro:include filename="$(find p3dx_description)/urdf/sensors/plugins.urdf.xacro" />
  <xacro:include filename="$(find p3dx_description)/urdf/sensors/imu.urdf.xacro" />
  <xacro:include filename="$(find p3dx_description)/urdf/sensors/generic_laser.urdf.xacro" />
  <xacro:include filename="$(find p3dx_description)/urdf/sensors/rplidar.urdf.xacro" />

  <!--<xacro:include filename="$(find p3dx_description)/urdf/sensors/depth_sensor.urdf.xacro" />-->
  <xacro:include filename="$(find p3dx_description)/urdf/controllers/diff_drive.urdf.xacro" />

  <xacro:property name="base_length" value="0.24" />
  <xacro:property name="base_width" value="0.34" />
  <xacro:property name="base_height" value="0.003" />
  <xacro:property name="base_mass" value="1" />
  <!-- set empty on the wheel_mesh_file to use geometry instead of mesh -->
  <xacro:property name="base_mesh_file" value="" />
  <!-- <xacro:property name="base_mesh_file" value="file://$(find p3dx_description)/meshes/base.dae" /> -->


  <xacro:property name="wheel_radius" value="0.12" />
  <xacro:property name="wheel_width" value="0.04" />
  <xacro:property name="wheel_pos_x" value="0.0" />
  <xacro:property name="wheel_pos_y" value="0.13" />
  <xacro:property name="wheel_pos_z" value="-0.03" />
  <xacro:property name="wheel_mass" value=".1" />
  <xacro:property name="wheel_torque" value="20" />
  <xacro:property name="front_caster_wheel" value="false" />
  <xacro:property name="rear_caster_wheel" value="true" />

  <xacro:property name="caster_wheel_radius" value="0.0375"/>

  <!-- Define robot constants -->
  <xacro:property name="base_width" value="0.34"/>
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="caster_wheel_width" value="0.01"/>

  <xacro:property name="rplidar_x_offset"              value="0"/>
  <xacro:property name="rplidar_y_offset"              value="0"/>
  <xacro:property name="rplidar_z_offset"              value="0.25"/>



  <!-- set empty on the wheel_mesh_file to use geometry instead of mesh -->
  <xacro:property name="wheel_mesh_file" value="" />
  <!-- <xacro:property name="wheel_mesh_file" value="file://$(find p3dx_description)/meshes/tire.dae" /> -->
  
  <xacro:property name="laser_pose">
    <origin xyz="0.12 0 0.33" rpy="0 0 0"/>
  </xacro:property>

  <xacro:property name="depth_sensor_pose">
    <origin xyz="0.14 0.0 0.045" rpy="0 0 0"/>
  </xacro:property>


  <xacro:base 
    length="${base_length}" 
    width="${base_width}" 
    height="${base_height}" 
    mass="${base_mass}"
    wheel_radius="${wheel_radius}"
    wheel_pos_z="${wheel_pos_z}"
    mesh_file="${base_mesh_file}"
  />

  <xacro:imu/>

  <xacro:rplidar frame_id="laser" parent_link="base_link">
    <origin xyz="${rplidar_x_offset} ${rplidar_y_offset} ${rplidar_z_offset}"
            rpy="0 0 ${pi/2}"/>
  </xacro:rplidar>


<!--
  <xacro:generic_laser>
    <xacro:insert_block name="laser_pose" />
  </xacro:generic_laser>
  -->
<!--
  <xacro:depth_sensor>
    <xacro:insert_block name="depth_sensor_pose" />
  </xacro:depth_sensor>
-->

</robot>