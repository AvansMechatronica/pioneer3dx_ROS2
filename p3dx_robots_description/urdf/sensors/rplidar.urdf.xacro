<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

<xacro:macro name="rplidar" params="frame_id parent_link *origin">
  <xacro:include filename="$(find p3dx_robots_description)/urdf/common_properties/common_properties.urdf.xacro"/>

  <xacro:property name="mass"       value="0.17"/>
  <xacro:property name="length_x"   value="${7.1*cm2m}" />
  <xacro:property name="length_y"   value="${10*cm2m}" />
  <xacro:property name="length_z"   value="${6*cm2m}" />

  <xacro:property name="collision_x_offset"       value="${0*cm2m}" />
  <xacro:property name="collision_y_offset"       value="${1.3*cm2m}" />
  <xacro:property name="collision_z_offset"       value="${-1.9*cm2m}" />


  <xacro:property name="topic_name"    value="/scan"/>
  <xacro:property name="update_rate"   value="10.0"/>
  <xacro:property name="ray_count"     value="360"/>
  <xacro:property name="min_angle"     value="${-pi}"/>
  <xacro:property name="max_angle"     value="${pi}"/>
  <xacro:property name="min_range"     value="0.08"/>
  <xacro:property name="max_range"     value="12.0"/>



  <joint name="${frame_id}_to_p3dx_base" type="fixed">
    <parent link="${parent_link}"/>
    <child link="${frame_id}"/>
    <xacro:insert_block name="origin"/>
  </joint>

  <link name="${frame_id}">
    <visual>
      <geometry>
        <mesh filename="package://p3dx_robots_description/meshes/rplidar.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="${collision_x_offset} ${collision_y_offset} ${collision_z_offset}"/>
      <geometry>
        <box size="${length_x} ${length_y} ${length_z}"/>
      </geometry>
    </collision>
    <xacro:inertial_cuboid mass="0.17" x="${length_x}" y="${length_y}" z="${length_z}"/>
  </link>

<!--
  <gazebo reference="${frame_id}_link">
    <xacro:ray_sensor sensor_name="${frame_id}" 
                  update_rate="62.0" visualize="1"
                  h_samples="640" h_res="1.0" h_min_angle="${-pi}" h_max_angle="${pi}"
                  r_min="0.164" r_max="12.0" r_res="0.01">
                  <plugin name="dummy" filename="dummyfile"></plugin>
    </xacro:ray_sensor>
    <xacro:material_darkgray/>
  </gazebo>
-->
    <gazebo reference="${frame_id}">
      <sensor name="gpu_lidar" type="gpu_lidar">
        <topic>${topic_name}</topic>
        <gz_frame_id>${frame_id}</gz_frame_id>
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>${ray_count}</samples>
              <resolution>1</resolution>
              <min_angle>${min_angle}</min_angle>
              <max_angle>${max_angle}</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>0.0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${min_range}</min>
            <max>${max_range}</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>


<!--
  <gazebo reference="${frame_id}_to_p3dx_base">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
-->
</xacro:macro>
</robot>
